{
  "version": 8,
  "center": [
    0,
    0
  ],
  "zoom": 0,
  "metadata": {
    "test": {
      "width": 256,
      "height": 256
    }
  },
  "sources": {
    "points": {
      "type": "vector",
      "encoding": "mlt",
      "minzoom": 0,
      "maxzoom": 0,
      "tiles": [
        "local://tiles/mlt/heatmap-globals/points.mlt"
      ]
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f5f3ed"
      }
    },
    {
      "id": "layer",
      "type": "circle",
      "source": "points",
      "source-layer": "points",
      "filter": [
        "is-supported-script",
        [
          "get",
          "label"
        ]
      ],
      "paint": {
        "circle-radius": 10,
        "circle-color": "#008060"
      }
    }
  ]
}
