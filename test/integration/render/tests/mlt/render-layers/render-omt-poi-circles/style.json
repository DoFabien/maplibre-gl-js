            }
        },
        {
            "id": "omt-poi-circles",
            "type": "circle",
            "source": "openmaptiles",
            "source-layer": "poi",
            "filter": [
                "any",
                ["==", ["get", "class"], "railway"],
                ["==", ["get", "class"], "bus"],
                ["==", ["get", "class"], "hospital"]
            ],
            "paint": {
                "circle-radius": [
                    "match",
                    ["get", "class"],
                    "railway",
                    9,
                    "hospital",
                    8,
                    7
                ],
                "circle-color": [
                    "match",
                    ["get", "class"],
                    "railway",
                    "#2563eb",
                    "hospital",
                    "#ef4444",
                    "#22c55e"
                ],
                "circle-stroke-width": 2,
                "circle-stroke-color": "#0f172a",
                "circle-opacity": 0.95
            }
        }
    ]
